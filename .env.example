# สร้างคีย์ฟรีที่ https://aistudio.google.com/apikey
# วางค่าจริงใน .env.local เท่านั้น อย่าใส่คีย์จริงในไฟล์นี้
GEMINI_API_KEY=
GEMINI_API_KEY_spare=
GEMINI_API_KEY_spare_2=

# Google Drive — OAuth แบบ Web application
# วางค่าจริงใน .env.local เท่านั้น
# Redirect ที่ลงทะเบียนไว้: http://localhost:3000/api/drive/callback
CLIENT_ID=
CLIENT_SECRET=

# โฟลเดอร์ในไดรฟ์ของฉัน ที่จะเก็บหน้าแปล คั่นด้วย /
# DRIVE_FOLDER=traslateManga/image

# ไม่บังคับ: ใช้ SpaceXAI แทนถ้ามีเครดิต จาก https://console.x.ai
# XAI_API_KEY=

# ไม่บังคับ: auto | gemini | xai
# TRANSLATE_PROVIDER=auto
# งานยาก (มังงะ / ช่องที่อ่านไม่ชัด)
# GEMINI_MODEL=gemini-3.6-flash
# งานทั่วไป / Auto fallback ช่องเดียว
# GEMINI_MODEL_LITE=gemini-3.1-flash-lite
